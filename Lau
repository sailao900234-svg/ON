-- [ AUTO LOCK WEIGHT POSITION (0.1 SEC) ] --
MainTab:CreateToggle({
   Name = "Auto-Lock Weight Position (0.1s)",
   CurrentValue = false,
   Flag = "AutoLockWeightToggle",
   Callback = function(Value)
       _G.AutoLockWeight = Value
       task.spawn(function()
           while _G.AutoLockWeight do
               task.wait(0.1)
               pcall(function()
                   local player = game.Players.LocalPlayer
                   local character = player.Character
                   
                   if character and character:FindFirstChildOfClass("Humanoid") then
                       local humanoid = character:FindFirstChildOfClass("Humanoid")
                       local toolInHand = character:FindFirstChildOfClass("Tool")
                       
                       if not toolInHand then
                           local toolInBackpack = player.Backpack:FindFirstChildOfClass("Tool")
                           if toolInBackpack then
                               humanoid:EquipTool(toolInBackpack)
                           end
                       else
                           toolInHand:Activate()
                       end
                   end
               end)
           end
       end)
   end,
})

-- [ AUTO TRAIN MUSCLE (0.1 SEC) ] --
MainTab:CreateToggle({
   Name = "Auto Train Muscle (ฝึกกล้ามเนื้อ 0.1s)",
   CurrentValue = false,
   Flag = "AutoTrainMuscleToggle",
   Callback = function(Value)
       _G.AutoTrainMuscle = Value
       task.spawn(function()
           while _G.AutoTrainMuscle do
               task.wait(0.1)
               pcall(function()
                   local replicatedStorage = game:GetService("ReplicatedStorage")
                   local trainEvents = {
                       replicatedStorage:FindFirstChild("Train", true),
                       replicatedStorage:FindFirstChild("TrainMuscle", true),
                       replicatedStorage:FindFirstChild("Lift", true),
                       replicatedStorage:FindFirstChild("GainMuscle", true),
                       replicatedStorage:FindFirstChild("AddMuscle", true)
                   }
                   
                   for _, event in ipairs(trainEvents) do
                       if event then
                           if event:IsA("RemoteEvent") then
                               event:FireServer()
                           elseif event:IsA("RemoteFunction") then
                               event:InvokeServer()
                           end
                       end
                   end
               end)
           end
       end)
   end,
})

-- [ INSTANT AUTO-WARP TO SELL 0.01 SEC ] --
MainTab:CreateToggle({
   Name = "Auto-Warp to Sell Instant (0.01s)",
   CurrentValue = false,
   Flag = "InstantWarpSellToggle",
   Callback = function(Value)
       _G.InstantWarpSell = Value
       task.spawn(function()
           while _G.InstantWarpSell do
               task.wait(0.01)
               pcall(function()
                   local player = game.Players.LocalPlayer
                   local character = player.Character
                   
                   local sellPart = workspace:FindFirstChild("SellPart", true) 
                       or workspace:FindFirstChild("SellArea", true) 
                       or workspace:FindFirstChild("Sell", true)
                   
                   if sellPart and character and character:FindFirstChild("HumanoidRootPart") then
                       if sellPart:IsA("BasePart") then
                           character.HumanoidRootPart.CFrame = sellPart.CFrame + Vector3.new(0, 3, 0)
                       elseif sellPart:IsA("Model") and sellPart.PrimaryPart then
                           character.HumanoidRootPart.CFrame = sellPart.PrimaryPart.CFrame + Vector3.new(0, 3, 0)
                       end
                   end
                   
                   local sellEvent = game:GetService("ReplicatedStorage"):FindFirstChild("Sell", true) 
                       or game:GetService("ReplicatedStorage"):FindFirstChild("SellMuscle", true)
                   if sellEvent then
                       if sellEvent:IsA("RemoteEvent") then
                           sellEvent:FireServer()
                       elseif sellEvent:IsA("RemoteFunction") then
                           sellEvent:InvokeServer()
                       end
                   end
               end)
           end
       end)
   end,
})

