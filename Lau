-- ลูปรักษาความเร็วและการกระโดดให้คงที่
task.spawn(function()
   while task.wait(0.2) do
       pcall(function()
           local player = game.Players.LocalPlayer
           if player.Character and player.Character:FindFirstChildOfClass("Humanoid") then
               local hum = player.Character:FindFirstChildOfClass("Humanoid")
               
               -- รักษาความเร็ว
               if _G.WalkSpeedValue and hum.WalkSpeed ~= _G.WalkSpeedValue then
                   hum.WalkSpeed = _G.WalkSpeedValue
               end
               
               -- รักษาความสูงการกระโดด
               if _G.JumpPowerValue and hum.JumpPower ~= _G.JumpPowerValue then
                   hum.UseJumpPower = true
                   hum.JumpPower = _G.JumpPowerValue
               end
           end
       end)
   end
end)

